using Osysharp.Diff;
using Osysharp.Ui;

/// Four files in one `git diff`: a changed line, a rename whose last line has no newline on either side, a new binary
/// file and a deleted file.
public string MultiFilePatch() =>
    "diff --git a/src/app.txt b/src/app.txt\n"
  + "index 1111111..2222222 100644\n"
  + "--- a/src/app.txt\n"
  + "+++ b/src/app.txt\n"
  + "@@ -1,3 +1,3 @@ section one\n"
  + " alpha\n"
  + "-let total = price + tax;\n"
  + "+let total = price + vat;\n"
  + " omega\n"
  + "diff --git a/old/name.txt b/new/name.txt\n"
  + "similarity index 90%\n"
  + "rename from old/name.txt\n"
  + "rename to new/name.txt\n"
  + "index 3333333..4444444 100644\n"
  + "--- a/old/name.txt\n"
  + "+++ b/new/name.txt\n"
  + "@@ -1,2 +1,2 @@\n"
  + " keep\n"
  + "-last\n"
  + "\\ No newline at end of file\n"
  + "+last line\n"
  + "\\ No newline at end of file\n"
  + "diff --git a/assets/logo.png b/assets/logo.png\n"
  + "new file mode 100644\n"
  + "index 0000000..5555555\n"
  + "Binary files /dev/null and b/assets/logo.png differ\n"
  + "diff --git a/gone.txt b/gone.txt\n"
  + "deleted file mode 100644\n"
  + "index 6666666..0000000\n"
  + "--- a/gone.txt\n"
  + "+++ /dev/null\n"
  + "@@ -1 +0,0 @@\n"
  + "-bye\n";

/// Removed lines that READ like file headers: a hunk ends when its counts are used up, not at a line that looks like
/// `---` or `+++`.
public string HeaderLookalikePatch() =>
    "--- q.sql\t2026-11-13 10:00:00\n"
  + "+++ q.sql\t2026-11-13 10:01:00\n"
  + "@@ -1,2 +1,2 @@\n"
  + "--- old comment\n"
  + "-+++ not a header\n"
  + "+-- new comment\n"
  + "+select 1;\n";

/// Hostile text everywhere a diff carries text: the path, the hunk's section, and the lines.
public string HostilePatch() =>
    "diff --git a/<i>x</i>.html b/<i>x</i>.html\n"
  + "--- a/<i>x</i>.html\n"
  + "+++ b/<i>x</i>.html\n"
  + "@@ -1,1 +1,2 @@ <b>section</b>\n"
  + "-nothing here\n"
  + "+<script>alert(\"x\")</script> {name} **not bold** [[link]] @if &amp;\n"
  + "+**still not bold** and _not italic_ <img src=x onerror=alert(1)>\n";

/// A 20-line file whose lines 5 and 15 changed, as `git diff` prints it with three lines of context: two hunks, one
/// unchanged line before the first, three between them and two after the last.
public string TwentyOld() {
  var s = "";
  for (var i = 1; i <= 20; i++) {
    s = s + "line " + i + "\n";
  }
  return s;
}

public string TwentyNew() => TwentyOld().Replace("line 5\n", "line five\n").Replace("line 15\n", "line fifteen\n");

public string TwentyPatch() =>
    "diff --git a/twenty.txt b/twenty.txt\n"
  + "--- a/twenty.txt\n"
  + "+++ b/twenty.txt\n"
  + "@@ -2,7 +2,7 @@\n"
  + " line 2\n line 3\n line 4\n"
  + "-line 5\n"
  + "+line five\n"
  + " line 6\n line 7\n line 8\n"
  + "@@ -12,7 +12,7 @@\n"
  + " line 12\n line 13\n line 14\n"
  + "-line 15\n"
  + "+line fifteen\n"
  + " line 16\n line 17\n line 18\n";

/// A run of two removed lines replaced by three added ones, between two unchanged lines.
public string ReplacePatch() =>
    "@@ -1,4 +1,5 @@\n"
  + " start\n"
  + "-let total = price + tax;\n"
  + "-print(total);\n"
  + "+let total = price + vat;\n"
  + "+print(total);\n"
  + "+log(total);\n"
  + " end\n";

/// An app re-dresses the diff by shadowing its tokens — this one gives the folds the theme's muted tint.
theme DiffKitTests {
  Colors {
    DiffFoldBg = Colors.Muted;
  }
}

/// Every kind of diff the kit draws, each under its own label so a test can say which one it means.
[Route("/")]
[AllowAnonymous]
component Gallery() {
  head { Title = "Diff"; }
  render {
    Stack(gap: 6, p: 6, bg: Colors.Bg, color: Colors.OnBg, minH: Length.Screen) {
      Row(align: Align.Center, gap: 3) {
        Text("Diff", fontSize: FontSize.Title, fontWeight: FontWeight.Semibold);
        Spacer();
        ThemeToggle(label: "Switch theme");
      }
      DiffView(MultiFilePatch(), label: "Several files");
      DiffView(HostilePatch(), label: "Hostile");
      DiffView(TwentyPatch(), oldText: TwentyOld(), newText: TwentyNew(), label: "Expandable");
      DiffView(ReplacePatch(), layout: DiffLayout.Split, label: "Side by side");
      DiffView(TwentyPatch(), maxLines: 9, label: "Capped");
    }
  }
}
