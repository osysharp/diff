// The producer's test project for Osysharp.Diff — the parser, the folds, the word highlights, the caps and the split
// pairing checked as functions, and a gallery page whose diffs are read and opened the way a person would.
app DiffKitTests {
  model "model/**/*.osy";
  tests "**/*.test.osy";
  use Osysharp.Diff@1;
  use Osysharp.Ui;
}
